# Copiar este archivo como application-local.properties en la raiz del proyecto.
# Completar los valores solamente en la copia local.
spring.datasource.url=jdbc:mysql://localhost:3306/biblioteca_idat_db
spring.datasource.username=replace_with_your_database_username
spring.datasource.password=replace_with_your_database_password
jwt.secret=replace_with_a_base64_encoded_secret_of_at_least_32_bytes
